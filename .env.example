# Local development only. Copy to .env and replace with your own values.
# Create this disposable PostgreSQL database before running Prisma schema setup.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentshack_dev"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Your development Privy app ID is required for wallet/auth UI.
NEXT_PUBLIC_PRIVY_APP_ID=""
# Server-side Privy verification only. Never use a NEXT_PUBLIC_ prefix for secrets.
PRIVY_APP_SECRET=""

# No private keys, production credentials, relayer or settlement flags are supplied.
# This file does not change the fixed BSC Testnet marketplace configuration.
